# PostgreSQL
POSTGRES_DB=annotation_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API database connection. Leave unset when using the default Docker DB.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/annotation_platform

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional seed credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_PM_EMAIL=pm@example.com
SEED_PM_PASSWORD=PM@123
